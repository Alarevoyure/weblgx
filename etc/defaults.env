# Valeurs par défaut de l'installation Web@LGX.
# Pour surcharger sans modifier ce fichier : /etc/weblgx/install.env

WEBLGX_DB_NAME="${WEBLGX_DB_NAME:-weblgx}"
WEBLGX_DB_USER="${WEBLGX_DB_USER:-weblgx}"
WEBLGX_SYSTEM_USER="${WEBLGX_SYSTEM_USER:-weblgx}"
WEBLGX_HTTP_PORT="${WEBLGX_HTTP_PORT:-7069}"
WEBLGX_LANG="${WEBLGX_LANG:-fr_FR}"

WEBLGX_CONFIG="${WEBLGX_CONFIG:-/etc/weblgx/weblgx.conf}"
WEBLGX_ENGINE_ADDONS="${WEBLGX_ENGINE_ADDONS:-/usr/lib/python3/dist-packages/odoo/addons}"
WEBLGX_DATA_DIR="${WEBLGX_DATA_DIR:-/var/lib/weblgx}"
WEBLGX_LOG_DIR="${WEBLGX_LOG_DIR:-/var/log/weblgx}"
WEBLGX_LOG_FILE="${WEBLGX_LOG_FILE:-/var/log/weblgx/weblgx.log}"
WEBLGX_CREDENTIALS="${WEBLGX_CREDENTIALS:-/root/weblgx-credentials.txt}"

# wkhtmltopdf 0.12.6.1 (Qt patché). Le build bookworm tourne aussi sur Debian 13.
WKHTML_DEB_URL="${WKHTML_DEB_URL:-https://github.com/wkhtmltopdf/packaging/releases/download/0.12.6.1-3/wkhtmltox_0.12.6.1-3.bookworm_amd64.deb}"

# Liste figée : modules installés sur la machine de référence, rien de plus.
_defaults_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WEBLGX_MODULES=()
while IFS= read -r _mod || [[ -n "${_mod}" ]]; do
  [[ -z "${_mod}" || "${_mod}" == \#* ]] && continue
  WEBLGX_MODULES+=("${_mod}")
done < "${_defaults_dir}/modules.list"
unset _mod _defaults_dir
