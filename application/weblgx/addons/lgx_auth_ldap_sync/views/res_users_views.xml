<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_tree_ldap_reload" model="ir.ui.view">
        <field name="name">res.users.tree.ldap.reload</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <header>
                    <button name="action_lgx_reload_ldap_users"
                            type="object"
                            string="Recharger depuis LDAP"
                            groups="base.group_erp_manager"
                            display="always"/>
                </header>
            </xpath>
        </field>
    </record>

    <record id="view_users_form_ldap_flag" model="ir.ui.view">
        <field name="name">res.users.form.ldap.flag</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']/group" position="after">
                <group string="LDAP" groups="base.group_no_one">
                    <field name="lgx_from_ldap"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
