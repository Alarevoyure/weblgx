<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="website_astuce_rule_company" model="ir.rule">
            <field name="name">Astuce du jour: sociétés autorisées</field>
            <field name="model_id" ref="model_website_astuce"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', user.company_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('website.group_website_designer')), (4, ref('website.group_website_restricted_editor'))]"/>
        </record>
        <record id="website_astuce_rule_system" model="ir.rule">
            <field name="name">Astuce du jour: administrateurs (sociétés autorisées)</field>
            <field name="model_id" ref="model_website_astuce"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', user.company_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        </record>
    </data>
</odoo>
