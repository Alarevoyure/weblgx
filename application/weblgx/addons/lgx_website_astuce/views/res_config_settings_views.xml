<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_astuce" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.astuce</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Astuce du jour" string="Astuce du jour" name="lgx_website_astuce">
                    <setting type="header" string="Site web">
                        <field name="website_id" options="{'no_open': True, 'no_create': True}"/>
                    </setting>
                    <block title="DeepSeek" id="astuce_deepseek_settings">
                        <setting string="Clé API DeepSeek"
                                 help="Clé isolée par site (platform.deepseek.com). Nécessaire pour générer les astuces.">
                            <field name="deepseek_api_key" password="True"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
