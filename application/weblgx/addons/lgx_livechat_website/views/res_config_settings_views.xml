<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.lgx.livechat.website</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_livechat.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='channel_id']" position="attributes">
                <attribute name="domain">[('website_id', 'in', (False, website_id))]</attribute>
                <attribute name="context">{'default_website_id': website_id}</attribute>
            </xpath>
        </field>
    </record>

</odoo>
