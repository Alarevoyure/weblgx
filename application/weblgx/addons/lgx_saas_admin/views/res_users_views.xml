<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Domain UI: company Admin only sees their companies in the picker.
             SuperAdmin has no domain (empty via fields_get / record rules). -->
        <record id="view_users_form_saas_admin" model="ir.ui.view">
            <field name="name">res.users.form.saas.admin</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='company_ids']" position="attributes">
                    <attribute name="options">{"no_create": True, "color_field": "color"}</attribute>
                    <attribute name="domain">[]</attribute>
                </xpath>
                <!-- Domain is enforced in Python fields_get for non-SuperAdmin;
                     keep XML domain empty so SuperAdmin is not restricted. -->
            </field>
        </record>
    </data>
</odoo>
