<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Company Admin (Access Rights): only their companies — no global view. -->
        <record id="base.res_company_rule_erp_manager" model="ir.rule">
            <field name="domain_force">[('id', 'in', user.company_ids.ids)]</field>
        </record>

        <!-- SuperAdmin: all companies. -->
        <record id="res_company_rule_superadmin" model="ir.rule">
            <field name="name">company rule superadmin</field>
            <field name="model_id" ref="base.model_res_company"/>
            <field name="groups" eval="[Command.set([ref('lgx_saas_admin.group_superadmin')])]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Users: only self + users sharing at least one of my allowed
             companies (user.company_ids, NOT session company_ids). -->
        <record id="base.res_users_rule" model="ir.rule">
            <field name="domain_force">['|', ('id', '=', user.id), ('company_ids', 'in', user.company_ids.ids)]</field>
        </record>

        <!-- SuperAdmin: all users. -->
        <record id="res_users_rule_superadmin" model="ir.rule">
            <field name="name">user rule superadmin</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="groups" eval="[Command.set([ref('lgx_saas_admin.group_superadmin')])]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Internal contacts: employees are isolated by company.
             External partners (portal/public/shared) remain visible to all. -->
        <record id="base.res_partner_rule" model="ir.rule">
            <field name="domain_force">['|', ('partner_share', '!=', False), '|', ('company_id', 'in', user.company_ids.ids), ('company_id', '=', False)]</field>
        </record>

        <record id="res_partner_rule_superadmin" model="ir.rule">
            <field name="name">res.partner rule superadmin</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="groups" eval="[Command.set([ref('lgx_saas_admin.group_superadmin')])]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Calendar: "Everybody's calendars" must stay within allowed companies. -->
        <record id="calendar.calendar_event_rule_employee" model="ir.rule">
            <field name="domain_force">['|', ('partner_ids', 'in', user.partner_id.id), ('user_id.company_id', 'in', company_ids)]</field>
        </record>

        <record id="calendar_event_rule_superadmin" model="ir.rule">
            <field name="name">calendar event rule superadmin</field>
            <field name="model_id" ref="calendar.model_calendar_event"/>
            <field name="groups" eval="[Command.set([ref('lgx_saas_admin.group_superadmin')])]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- SuperAdmin bypass: Admin (Settings) stays on the company-scoped rules. -->
        <record id="website_rule_superadmin" model="ir.rule">
            <field name="name">Website: all companies (SuperAdmin)</field>
            <field name="model_id" ref="website.model_website"/>
            <field name="groups" eval="[Command.set([ref('lgx_saas_admin.group_superadmin')])]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        <record id="website_page_rule_superadmin" model="ir.rule">
            <field name="name">Website pages: all companies (SuperAdmin)</field>
            <field name="model_id" ref="website.model_website_page"/>
            <field name="groups" eval="[Command.set([ref('lgx_saas_admin.group_superadmin')])]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        <record id="website_menu_rule_superadmin" model="ir.rule">
            <field name="name">Website menus: all companies (SuperAdmin)</field>
            <field name="model_id" ref="website.model_website_menu"/>
            <field name="groups" eval="[Command.set([ref('lgx_saas_admin.group_superadmin')])]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        <record id="ir_ui_view_rule_superadmin" model="ir.rule">
            <field name="name">Views: all companies (SuperAdmin)</field>
            <field name="model_id" ref="base.model_ir_ui_view"/>
            <field name="groups" eval="[Command.set([ref('lgx_saas_admin.group_superadmin')])]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        <record id="wiki_page_rule_superadmin" model="ir.rule">
            <field name="name">Wiki pages: all companies (SuperAdmin)</field>
            <field name="model_id" ref="wiki_knowledge.model_wiki_page"/>
            <field name="groups" eval="[Command.set([ref('lgx_saas_admin.group_superadmin')])]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        <record id="wiki_gallery_item_rule_superadmin" model="ir.rule">
            <field name="name">Wiki gallery: all companies (SuperAdmin)</field>
            <field name="model_id" ref="wiki_knowledge.model_wiki_gallery_item"/>
            <field name="groups" eval="[Command.set([ref('lgx_saas_admin.group_superadmin')])]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        <record id="wiki_gallery_rule_superadmin" model="ir.rule">
            <field name="name">Wiki gallery lib: all companies (SuperAdmin)</field>
            <field name="model_id" ref="wiki_knowledge.model_wiki_gallery"/>
            <field name="groups" eval="[Command.set([ref('lgx_saas_admin.group_superadmin')])]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        <record id="wiki_verified_email_rule_superadmin" model="ir.rule">
            <field name="name">Wiki verified email: all companies (SuperAdmin)</field>
            <field name="model_id" ref="wiki_knowledge.model_wiki_gallery_verified_email"/>
            <field name="groups" eval="[Command.set([ref('lgx_saas_admin.group_superadmin')])]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        <record id="website_astuce_rule_superadmin" model="ir.rule">
            <field name="name">Astuce du jour: all companies (SuperAdmin)</field>
            <field name="model_id" ref="lgx_website_astuce.model_website_astuce"/>
            <field name="groups" eval="[Command.set([ref('lgx_saas_admin.group_superadmin')])]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        <record id="livechat_channel_rule_superadmin" model="ir.rule">
            <field name="name">Livechat channels: all companies (SuperAdmin)</field>
            <field name="model_id" ref="im_livechat.model_im_livechat_channel"/>
            <field name="groups" eval="[Command.set([ref('lgx_saas_admin.group_superadmin')])]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        <record id="ir_attachment_rule_superadmin" model="ir.rule">
            <field name="name">Attachments: all companies (SuperAdmin)</field>
            <field name="model_id" ref="base.model_ir_attachment"/>
            <field name="groups" eval="[Command.set([ref('lgx_saas_admin.group_superadmin')])]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

    </data>
</odoo>
