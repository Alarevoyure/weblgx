             data-snippet="s_wiki_toc"
             data-name="Wiki Sommaire"
             style="--wiki-border-color: #16213e;">
        <div class="container-fluid">
            <aside class="o_wiki_toc o_wiki_toc_snippet o_not_editable w-100"
