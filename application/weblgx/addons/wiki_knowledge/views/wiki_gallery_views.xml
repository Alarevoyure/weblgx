<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Bibliothèques (une par page / sujet) -->
    <record id="view_wiki_gallery_tree" model="ir.ui.view">
        <field name="name">wiki.gallery.tree</field>
        <field name="model">wiki.gallery</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="website_id"/>
                <field name="pending_count"/>
                <field name="item_count"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_wiki_gallery_form" model="ir.ui.view">
        <field name="name">wiki.gallery.form</field>
        <field name="model">wiki.gallery</field>
        <field name="arch" type="xml">
            <form string="Bibliothèque d'images">
                <header>
                    <button name="action_purge_with_items" type="object" string="Supprimer avec les contributions"
                            class="btn-danger"
                            confirm="Supprimer cette bibliothèque et toutes ses photos / textes ?"
                            groups="wiki_knowledge.group_wiki_reviewer,wiki_knowledge.group_wiki_manager,base.group_system,website.group_website_designer"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_items" type="object" class="oe_stat_button" icon="fa-picture-o">
                            <field name="item_count" widget="statinfo" string="Contributions"/>
                        </button>
                        <button name="action_open_items" type="object" class="oe_stat_button" icon="fa-clock-o">
                            <field name="pending_count" widget="statinfo" string="À valider"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Ex. : Page Histoire locale"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="website_id" options="{'no_create': True}"/>
                            <field name="company_id" readonly="1"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <separator string="Description"/>
                    <field name="description"
                             nolabel="1"
                             class="o_wiki_gallery_text"
                             placeholder="Sujet de cette bibliothèque / page…"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_wiki_gallery" model="ir.actions.act_window">
        <field name="name">Bibliothèques</field>
        <field name="res_model">wiki.gallery</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez une bibliothèque par page web.
            </p>
            <p>
                Ensuite, dans l'éditeur de page, sélectionnez cette bibliothèque
                dans les options du bloc « Bibliothèque Wiki ».
            </p>
        </field>
    </record>

    <!-- Contributions -->
    <record id="view_wiki_gallery_item_tree" model="ir.ui.view">
        <field name="name">wiki.gallery.item.tree</field>
        <field name="model">wiki.gallery.item</field>
        <field name="arch" type="xml">
            <tree decoration-info="state == 'submitted'"
                  decoration-success="state == 'published'"
                  decoration-muted="state == 'refused'">
                <field name="sequence" widget="handle"/>
                <field name="image" widget="image" options="{'size': [96, 96]}"/>
                <field name="name"/>
                <field name="gallery_id"/>
                <field name="contributor_name"/>
                <field name="contributor_email"/>
                <field name="media_filename" optional="hide"/>
                <field name="website_id"/>
                <field name="submitted_date"/>
                <field name="view_count"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_wiki_gallery_item_kanban" model="ir.ui.view">
        <field name="name">wiki.gallery.item.kanban</field>
        <field name="model">wiki.gallery.item</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="state">
                <field name="id"/>
                <field name="name"/>
                <field name="text_preview"/>
                <field name="image"/>
                <field name="gallery_id"/>
                <field name="contributor_name"/>
                <field name="contributor_email"/>
                <field name="state"/>
                <field name="submitted_date"/>
                <field name="view_count"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_wiki_gallery_kanban_card">
                            <div class="o_wiki_gallery_kanban_preview">
                                <field name="image" widget="image" class="o_wiki_gallery_kanban_img"/>
                            </div>
                            <div class="o_kanban_details p-2">
                                <strong t-if="record.name.raw_value" t-esc="record.name.value"/>
                                <strong t-else="" class="text-muted">Sans titre</strong>
                                <div class="text-muted small" t-esc="record.gallery_id.value"/>
                                <div class="o_wiki_gallery_kanban_text mt-1" t-esc="record.text_preview.value"/>
                                <div class="text-muted small mt-1">
                                    <t t-esc="record.view_count.value"/> vues
                                </div>
                                <div t-if="record.contributor_name.raw_value" class="text-muted small mt-1">
                                    — <t t-esc="record.contributor_name.value"/>
                                </div>
                                <div t-if="record.contributor_email.raw_value" class="text-muted small">
                                    <t t-esc="record.contributor_email.value"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_wiki_gallery_item_form" model="ir.ui.view">
        <field name="name">wiki.gallery.item.form</field>
        <field name="model">wiki.gallery.item</field>
        <field name="arch" type="xml">
            <form string="Contribution Wiki">
                <header>
                    <button name="action_publish" type="object" string="Publier"
                            class="btn-success"
                            invisible="state == 'published'"
                            groups="wiki_knowledge.group_wiki_reviewer,wiki_knowledge.group_wiki_manager,base.group_system"/>
                    <button name="action_refuse" type="object" string="Refuser"
                            class="btn-danger"
                            invisible="state == 'refused'"
                            groups="wiki_knowledge.group_wiki_reviewer,wiki_knowledge.group_wiki_manager,base.group_system"/>
                    <button name="action_reset_to_submitted" type="object" string="Remettre à valider"
                            class="btn-secondary"
                            invisible="state == 'submitted'"
                            groups="wiki_knowledge.group_wiki_reviewer,wiki_knowledge.group_wiki_manager,base.group_system"/>
                    <field name="state" widget="statusbar" statusbar_visible="submitted,published,refused"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="gallery_id" options="{'no_create_edit': True}"/>
                            <field name="name"/>
                            <field name="contributor_name"/>
                            <field name="contributor_email" widget="email"/>
                            <field name="website_id" readonly="1"/>
                            <field name="company_id" readonly="1"/>
                            <field name="sequence"/>
                            <field name="view_count"/>
                            <field name="submitted_date" readonly="1"/>
                        </group>
                    </group>
                    <field name="media_mimetype" invisible="1"/>
                    <field name="media_filename" invisible="1"/>
                    <separator string="Vidéo ou audio" invisible="not media_filename"/>
                    <field name="media_filename" widget="wiki_media_player" nolabel="1"
                           invisible="not media_filename"/>
                    <field name="media" filename="media_filename" widget="binary"
                           invisible="not media_filename"/>
                    <separator string="Aperçu de la photo"/>
                    <div class="o_wiki_gallery_preview_wrap">
                        <field name="image" widget="image" class="o_wiki_gallery_preview_image" nolabel="1"
                                 options="{'size': [0, 0], 'zoom': true}"/>
                    </div>
                    <separator string="Texte"/>
                    <field name="text" widget="html" nolabel="1" class="o_wiki_gallery_text"
                             options="{'style-inline': true, 'codeview': true}"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_wiki_gallery_item_search" model="ir.ui.view">
        <field name="name">wiki.gallery.item.search</field>
        <field name="model">wiki.gallery.item</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="contributor_name"/>
                <field name="contributor_email"/>
                <field name="text"/>
                <field name="gallery_id"/>
                <field name="website_id"/>
                <filter name="to_validate" string="À valider" domain="[('state', '=', 'submitted')]"/>
                <filter name="published" string="Publiées" domain="[('state', '=', 'published')]"/>
                <filter name="refused" string="Refusées" domain="[('state', '=', 'refused')]"/>
                <filter name="orphans" string="Sans bibliothèque" domain="[('gallery_id', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_gallery" string="Bibliothèque" context="{'group_by': 'gallery_id'}"/>
                    <filter name="group_state" string="Statut" context="{'group_by': 'state'}"/>
                    <filter name="group_website" string="Site web" context="{'group_by': 'website_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_wiki_gallery_items" model="ir.actions.act_window">
        <field name="name">Contributions</field>
        <field name="res_model">wiki.gallery.item</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_to_validate': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucune contribution pour le moment.
            </p>
            <p>
                Créez d'abord une bibliothèque, associez-la au bloc sur la page,
                puis validez ici les dépôts des visiteurs.
            </p>
        </field>
    </record>
</odoo>
