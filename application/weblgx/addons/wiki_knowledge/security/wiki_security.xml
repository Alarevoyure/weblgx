<odoo>
    <data noupdate="1">
        <record id="group_wiki_user" model="res.groups">
            <field name="name">Wiki User</field>
        </record>

        <record id="group_wiki_reviewer" model="res.groups">
            <field name="name">Wiki Reviewer</field>
            <field name="implied_ids" eval="[(4, ref('wiki_knowledge.group_wiki_user'))]"/>
        </record>

        <record id="group_wiki_manager" model="res.groups">
            <field name="name">Wiki Manager</field>
            <field name="implied_ids" eval="[(4, ref('wiki_knowledge.group_wiki_reviewer'))]"/>
        </record>
    </data>

    <data>
        <record id="base.default_user" model="res.users">
            <field name="groups_id" eval="[(3, ref('website.group_website_designer')), (3, ref('website.group_website_restricted_editor'))]"/>
        </record>
    </data>

    <data noupdate="1">
        <record id="wiki_page_rule_public_visible" model="ir.rule">
            <field name="name">Wiki public: état + société du contexte</field>
            <field name="model_id" ref="model_wiki_page"/>
            <field name="domain_force">
                ['&amp;', '|', ('company_id', '=', False), ('company_id', '=', company_id), '|',
                ('state', '=', 'published'), '&amp;', ('state', 'in', ['to_review', 'approved']),
                ('last_published_content', '!=', False)]
            </field>
            <field name="groups" eval="[(4, ref('base.group_public'))]"/>
        </record>

        <!-- Sociétés : éditeurs / utilisateurs wiki ne voient que les pages de leurs sociétés autorisées (+ partagées company_id vide). Les admins gardent tout. -->
        <record id="wiki_page_rule_company_editors" model="ir.rule">
            <field name="name">Wiki pages: restricted to user companies</field>
            <field name="model_id" ref="model_wiki_page"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', user.company_ids.ids)]</field>
            <field name="groups" eval="[
                (4, ref('wiki_knowledge.group_wiki_user')),
                (4, ref('wiki_knowledge.group_wiki_reviewer')),
                (4, ref('wiki_knowledge.group_wiki_manager')),
                (4, ref('website.group_website_designer')),
                (4, ref('website.group_website_restricted_editor')),
            ]"/>
        </record>

        <record id="wiki_page_rule_company_system" model="ir.rule">
            <field name="name">Wiki pages: allowed companies (administrators)</field>
            <field name="model_id" ref="model_wiki_page"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', user.company_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        </record>

        <!-- Bibliothèque d'images Wiki -->
        <record id="wiki_gallery_rule_public_published" model="ir.rule">
            <field name="name">Wiki gallery public: published only</field>
            <field name="model_id" ref="model_wiki_gallery_item"/>
            <field name="domain_force">
                ['&amp;', ('state', '=', 'published'),
                 '|', ('company_id', '=', False), ('company_id', '=', company_id)]
            </field>
            <field name="groups" eval="[(4, ref('base.group_public'))]"/>
        </record>
        <record id="wiki_gallery_rule_portal_published" model="ir.rule">
            <field name="name">Wiki gallery portal: published only</field>
            <field name="model_id" ref="model_wiki_gallery_item"/>
            <field name="domain_force">
                ['&amp;', ('state', '=', 'published'),
                 '|', ('company_id', '=', False), ('company_id', '=', company_id)]
            </field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>
        <record id="wiki_gallery_rule_company_editors" model="ir.rule">
            <field name="name">Wiki gallery: restricted to user companies</field>
            <field name="model_id" ref="model_wiki_gallery_item"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', user.company_ids.ids)]</field>
            <field name="groups" eval="[
                (4, ref('wiki_knowledge.group_wiki_user')),
                (4, ref('wiki_knowledge.group_wiki_reviewer')),
                (4, ref('wiki_knowledge.group_wiki_manager')),
                (4, ref('website.group_website_designer')),
                (4, ref('website.group_website_restricted_editor')),
            ]"/>
        </record>
        <record id="wiki_gallery_rule_system" model="ir.rule">
            <field name="name">Wiki gallery: allowed companies (administrators)</field>
            <field name="model_id" ref="model_wiki_gallery_item"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', user.company_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        </record>

        <record id="wiki_gallery_lib_rule_public" model="ir.rule">
            <field name="name">Wiki gallery lib public: active + société</field>
            <field name="model_id" ref="model_wiki_gallery"/>
            <field name="domain_force">
                ['&amp;', ('active', '=', True),
                 '|', ('company_id', '=', False), ('company_id', '=', company_id)]
            </field>
            <field name="groups" eval="[(4, ref('base.group_public')), (4, ref('base.group_portal'))]"/>
        </record>
        <record id="wiki_gallery_lib_rule_company" model="ir.rule">
            <field name="name">Wiki gallery lib: restricted to user companies</field>
            <field name="model_id" ref="model_wiki_gallery"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', user.company_ids.ids)]</field>
            <field name="groups" eval="[
                (4, ref('wiki_knowledge.group_wiki_user')),
                (4, ref('wiki_knowledge.group_wiki_reviewer')),
                (4, ref('wiki_knowledge.group_wiki_manager')),
                (4, ref('website.group_website_designer')),
                (4, ref('website.group_website_restricted_editor')),
            ]"/>
        </record>
        <record id="wiki_gallery_lib_rule_system" model="ir.rule">
            <field name="name">Wiki gallery lib: allowed companies (administrators)</field>
            <field name="model_id" ref="model_wiki_gallery"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', user.company_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        </record>

        <record id="wiki_gallery_verified_email_rule_company" model="ir.rule">
            <field name="name">Wiki verified email: restricted to user companies</field>
            <field name="model_id" ref="model_wiki_gallery_verified_email"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', user.company_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('wiki_knowledge.group_wiki_manager'))]"/>
        </record>
        <record id="wiki_gallery_verified_email_rule_system" model="ir.rule">
            <field name="name">Wiki verified email: allowed companies (administrators)</field>
            <field name="model_id" ref="model_wiki_gallery_verified_email"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', user.company_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        </record>
    </data>
</odoo>
