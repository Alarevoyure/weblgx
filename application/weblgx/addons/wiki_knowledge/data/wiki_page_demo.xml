<odoo>
    <data noupdate="1">
        <record id="wiki_page_demo_home" model="wiki.page">
            <field name="name">Accueil Wiki</field>
            <field name="level">1</field>
            <field name="sequence">10</field>
            <field name="state">published</field>
            <field name="content"><![CDATA[
                <section class="s_text_block">
                    <div class="container">
                        <h1>Bienvenue</h1>
                        <p>Page de validation publique en lecture seule.</p>
                    </div>
                </section>
            ]]></field>
        </record>

        <record id="wiki_page_demo_guide" model="wiki.page">
            <field name="name">Guide Utilisateur</field>
            <field name="level">2</field>
            <field name="parent_id" ref="wiki_page_demo_home"/>
            <field name="sequence">20</field>
            <field name="state">published</field>
            <field name="content"><![CDATA[
                <section class="s_text_block">
                    <div class="container">
                        <h2>Guide</h2>
                        <p>Cette page permet de tester les liens du sommaire.</p>
                    </div>
                </section>
            ]]></field>
        </record>

        <record id="wiki_page_demo_draft" model="wiki.page">
            <field name="name">Brouillon Interne</field>
            <field name="level">1</field>
            <field name="sequence">30</field>
            <field name="state">draft</field>
            <field name="content"><![CDATA[
                <p>Ce brouillon ne doit pas etre visible pour un visiteur public.</p>
            ]]></field>
        </record>
    </data>
</odoo>
