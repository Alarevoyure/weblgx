<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_website_form_plexipost" model="ir.ui.view">
        <field name="name">website.form.plexipost</field>
        <field name="model">website</field>
        <field name="inherit_id" ref="website.view_website_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="PlexiPost" name="plexipost" groups="website.group_website_designer">
                    <group>
                        <field name="plexipost_receiver_url" widget="CopyClipboardChar"/>
                        <field name="plexipost_client_id"/>
                        <label for="plexipost_client_secret"/>
                        <div class="o_row">
                            <field name="plexipost_client_secret" password="True" nolabel="1"/>
                            <field name="plexipost_client_secret" widget="CopyClipboardButton" nolabel="1" string="Copy the secret"/>
                        </div>
                        <field name="plexipost_blog_id"/>
                    </group>
                    <button name="action_plexipost_generate_credentials" type="object"
                            string="Generate credentials" class="btn-secondary"/>
                    <p class="text-muted mt-2">In PlexiPost, set this receiver URL, the Client ID and the Secret. Each push is an HTTP POST with the headers X-Client-Id and X-Client-Secret.</p>
                </page>
            </xpath>
        </field>
    </record>

    <record id="res_config_settings_view_form_plexipost" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.plexipost</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='website_info_settings']" position="after">
                <block title="PlexiPost" id="website_blog_plexipost" invisible="not website_id">
                    <setting string="Article receiver" help="Address to enter in PlexiPost. Posts are created on this website only.">
                        <field name="plexipost_receiver_url" widget="CopyClipboardChar"/>
                    </setting>
                    <setting string="Client ID" help="Same value as in PlexiPost.">
                        <field name="plexipost_client_id"/>
                    </setting>
                    <setting string="Secret" help="Same value as in PlexiPost. It is checked on every push.">
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <field name="plexipost_client_secret" password="True"/>
                            <field name="plexipost_client_secret" widget="CopyClipboardButton" nolabel="1" string="Copy the secret"/>
                        </div>
                        <button name="action_plexipost_generate_credentials" type="object"
                                string="Generate credentials" class="btn-link" icon="oi-arrow-right"/>
                    </setting>
                    <setting string="Blog" help="Blog that receives the pushed articles.">
                        <field name="plexipost_blog_id"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
